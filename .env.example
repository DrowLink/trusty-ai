# ==========================================
# TRUSTY.ai - Persistent Database Configuration
# ==========================================

# 1. Firebase Firestore (Recommended for cloud/production persistence)
# Create a free project at https://console.firebase.google.com/
# Add a Web App in Project Settings to get these credentials:
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Alternative server-side variables (optional):
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 2. Local Fallback
# When Firebase variables are not set, TRUSTY.ai automatically uses
# dual-layer browser storage + server filesystem cache so your audited
# agents are NEVER lost across reloads or server restarts.
